# Jarvis AI Assistant - Environment Variables
# Copy this file to .env and fill in your API keys

# === REQUIRED FOR FULL AI CHAT ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === WEATHER (free) ===
# Get key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# === NEWS (free) ===
# Get key at: https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# === GMAIL ===
# Follow: https://developers.google.com/gmail/api/quickstart/python
GMAIL_ACCESS_TOKEN=your_gmail_token_here

# === SPOTIFY ===
# Setup at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_ACCESS_TOKEN=your_spotify_access_token

# === HOME ASSISTANT ===
# Your Home Assistant instance
HOME_ASSISTANT_URL=http://your-ha-instance:8123
HOME_ASSISTANT_TOKEN=your_long_lived_access_token

# === TRADING SYSTEM (see trading/README.md) ===
# Get keys at: https://alpaca.markets
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true
