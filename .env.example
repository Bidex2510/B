# Jarvis AI Assistant - Environment Variables
# Copy this file to .env and fill in your API keys

# === REQUIRED FOR FULL AI CHAT ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === WEATHER (free) ===
# Get key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# === NEWS (free) ===
# Get key at: https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# === GMAIL ===
# Follow: https://developers.google.com/gmail/api/quickstart/python
GMAIL_ACCESS_TOKEN=your_gmail_token_here

# === SPOTIFY ===
# Setup at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_ACCESS_TOKEN=your_spotify_access_token

# === HOME ASSISTANT ===
# Your Home Assistant instance
HOME_ASSISTANT_URL=http://your-ha-instance:8123
HOME_ASSISTANT_TOKEN=your_long_lived_access_token

# === TELEGRAM BOT (FREE - Phone Control) ===
# 1. Open Telegram, search @BotFather, send /newbot
# 2. Paste the token you receive below
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# === TIKTOK OFFICIAL CONTENT POSTING API ===
# Register a free app at https://developers.tiktok.com/
# Scopes needed: user.info.basic, video.publish, video.upload
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:8000/api/tiktok-publish/callback

# === TWILIO (Phone calls + SMS) ===
# Sign up at https://www.twilio.com/try-twilio - $15 free trial credit
# Calls ~$0.013/min, SMS ~$0.008/msg
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# === GOOGLE CALENDAR (FREE) ===
# Reuses GMAIL_ACCESS_TOKEN if scoped with https://www.googleapis.com/auth/calendar
# Or use https://developers.google.com/oauthplayground to mint a fresh one
GOOGLE_ACCESS_TOKEN=your_google_access_token

# === JARVIS DATA DIRECTORY ===
# Where Jarvis stores tokens, cache, etc. (default: /tmp/jarvis)
JARVIS_DATA_DIR=/tmp/jarvis
