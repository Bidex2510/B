# Jarvis AI Assistant + Trading Bot - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to git.

# ── AI (Required for chat and sentiment analysis) ────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── News / Sentiment (free tier at newsapi.org) ──────────────────────────────
NEWS_API_KEY=your_newsapi_key_here

# ── Robinhood Credentials (LIVE trading only) ────────────────────────────────
# Leave blank to stay in paper-trading mode.
RH_USERNAME=your_robinhood_email@example.com
RH_PASSWORD=your_robinhood_password

# Base-32 MFA secret from your Robinhood authenticator app setup.
# Open Robinhood → Account → Security → Two-Factor Auth → Show QR/Key
# Copy the alphanumeric key (NOT the QR image URL).
RH_MFA_KEY=YOUR_BASE32_MFA_SECRET

# ── Trading Bot Mode ─────────────────────────────────────────────────────────
# Set to "false" ONLY when you are ready to trade real money.
# Default is "true" (paper trading with a virtual $10,000 account).
PAPER_TRADING=true
PAPER_STARTING_BALANCE=10000

# ── Strategy Toggles ─────────────────────────────────────────────────────────
# Every strategy is on by default. Set any to "false" to disable.
#
#   swing    : 3-10 day pullback trades (RSI oversold + Bollinger Band)
#   position : 1-6 month fundamentals + golden cross
#   trend    : 2-6 week momentum (MACD + SMA + ADX)
#   breakout : 1-3 week new-high breakouts with volume confirmation
#   day      : intraday, force-closed by 15:45 ET (VWAP + opening range)
#   scalp    : 1-30 minute 1-min-bar momentum bursts (EMA9/EMA20 + volume)
#
# NOTE: day and scalp generate day-trades. If your Robinhood account is
# under $25,000 the PDT rule blocks you at 4 day trades per 5 business days;
# the bot enforces this automatically via PDT_ACCOUNT_EQUITY (below).
STRATEGY_SWING=true
STRATEGY_POSITION=true
STRATEGY_TREND=true
STRATEGY_BREAKOUT=true
STRATEGY_DAY=true
STRATEGY_SCALP=true

# ── Watchlist ────────────────────────────────────────────────────────────────
# Comma-separated list of stock/ETF tickers to watch.
# Leave blank to use the default 20 mega-cap stocks + 25 major ETFs.
# Example: AAPL,MSFT,SPY,QQQ,VTI,XLK
TRADING_WATCHLIST=

# How often (seconds) the bot re-scans during market hours.
# Default: 60s when day/scalp is active, 300s (5 min) otherwise.
SCAN_INTERVAL_SECONDS=

# Max stocks to analyze per cycle (to manage API rate limits). Default: 20.
MAX_CANDIDATES_PER_CYCLE=20

# Max BUY orders per cycle. Default: 2.
MAX_BUYS_PER_CYCLE=2

# ── Risk Management ──────────────────────────────────────────────────────────
# Max % of portfolio allocated to a single stock (0.05 = 5%). Default: 0.05.
RISK_MAX_POSITION_PCT=0.05

# Hard stop-loss: sell if price drops this % below your average cost. Default: -0.02 (-2%).
RISK_STOP_LOSS_PCT=-0.02

# Trailing stop: sell if price drops this % below its peak. Default: -0.03 (-3%).
RISK_TRAILING_STOP_PCT=-0.03

# Circuit breaker: freeze bot if daily portfolio loss exceeds this %. Default: -0.02 (-2%).
RISK_DAILY_MAX_LOSS_PCT=-0.02

# Max number of trades per calendar day. Default: 10.
RISK_MAX_DAILY_TRADES=10

# Your Robinhood account equity for PDT (Pattern Day Trader) protection.
# If below $25,000, bot blocks any 4th+ day trade in a 5-business-day window.
# Set to 25000 (or higher) to disable PDT guardrails.
PDT_ACCOUNT_EQUITY=0

# Where to persist open-position metadata (strategy, entry date, entry price).
TRADING_POSITIONS_FILE=~/.jarvis_positions.json

# ── Notifications (Telegram) ─────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram, then message @userinfobot for your chat ID.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_numeric_chat_id_here

# ── Other Jarvis Plugins ─────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_key_here

GMAIL_ACCESS_TOKEN=your_gmail_token_here

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_ACCESS_TOKEN=your_spotify_access_token

HOME_ASSISTANT_URL=http://your-ha-instance:8123
HOME_ASSISTANT_TOKEN=your_long_lived_access_token
